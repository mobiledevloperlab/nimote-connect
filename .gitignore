# Allow public docs, release automation, and approved release packages.
/*
!/.gitignore
!/README.md
!/docs/
/docs/**
!/docs/en/
!/docs/zh/
!/docs/es/
!/docs/ja/
!/docs/ko/
!/docs/release/
!/docs/en/install.md
!/docs/zh/README.md
!/docs/zh/install.md
!/docs/es/README.md
!/docs/es/install.md
!/docs/ja/README.md
!/docs/ja/install.md
!/docs/ko/README.md
!/docs/ko/install.md
!/docs/release/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/publish-release.yml
!/.github/publish-release.py
!/config/
/config/*
!/config/derp-release.json
!/release/
/release/*
!/release/nimote-connect-*.tar.gz
!/release/nimote-connect-*.tar.gz.sha256
!/release/nimote-connect-*.zip
!/release/nimote-connect-*.zip.sha256
!/release/v*.md
